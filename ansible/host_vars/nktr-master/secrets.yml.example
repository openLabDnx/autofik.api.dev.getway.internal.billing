# Copy to secrets.yml (gitignored) in this directory and fill in. Named
# .example so Ansible does not load it as host vars.
#
# Password SSH needs sshpass on this machine (apt install sshpass). Drop
# ansible_password once an SSH key is installed on the node.
ansible_password: "<ssh password for vongjx>"
ansible_become_password: "<sudo password for vongjx>"
